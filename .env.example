# Runtime environment: development | staging | production
APP_ENV=development

# Database connection string; SQLite for local development
DATABASE_URL=sqlite:///./escrow.db
# Example Supabase Postgres connection string:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=

# Supabase service-role key (server-side only; never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for blueprint uploads
SUPABASE_STORAGE_BUCKET=blueprints

# Lifetime in seconds of signed download URLs
SIGNED_URL_EXPIRY_SECONDS=3600

# Shared secret used to verify incoming webhook signatures (required in production)
WEBHOOK_SECRET=
